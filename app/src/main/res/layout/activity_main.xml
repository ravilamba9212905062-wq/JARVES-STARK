<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="JARVES STARK" android:textSize="30sp" android:textStyle="bold" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Switch android:id="@+id/toggle" android:text="JARVES ON / OFF" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/diagnostics" android:text="JARVES System Check / Diagnostics" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/security" android:text="Voice Security / Secret Password" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/settings" android:text="Voice & Accessibility Settings" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/aiConfig" android:text="AI API / Backend सेट करें" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/appFactory" android:text="नई App बनवाएँ (AI App Factory)" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/memory" android:text="Long-Term Memory / याददाश्त" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/content" android:text="AI Content Studio" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/editVideo" android:text="अपनी Video चुनें → AI से Edit करवाएँ" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/trading" android:text="Trading Assistant — Forex / Gold / Silver / Crypto" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/news" android:text="Market / News Alerts" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/media" android:text="Camera / Video / Screen / Voice / Delete" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/status" android:text="Status: OFF\nTrading: confirmation required\nAI: backend not configured\nMemory: local persistent storage" android:textSize="16sp" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
